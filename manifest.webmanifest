{
  "name": "ZABAC",
  "short_name": "ZABAC",
  "description": "Dosya açıcı: PDF, resim, video, ses ve metin dosyalarını internetsiz açar",
  "lang": "tr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16130d",
  "theme_color": "#facc15",
  "icons": [
    { "src": "ikon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "ikon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "ikon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".ico", ".avif"],
        "video/*": [".mp4", ".webm", ".mov", ".m4v", ".ogv", ".mkv"],
        "audio/*": [".mp3", ".wav", ".ogg", ".m4a", ".aac", ".flac", ".opus"],
        "text/*": [".txt", ".md", ".csv", ".log", ".json", ".xml", ".html", ".htm", ".css", ".js", ".ini", ".srt", ".vtt", ".yaml", ".yml"]
      }
    }
  ],
  "share_target": {
    "action": "./paylas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "dosya", "accept": ["*/*"] }] }
  }
}
