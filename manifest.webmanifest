{
  "name": "ZABAC",
  "short_name": "ZABAC",
  "description": "Dosya açıcı: PDF, Excel, resim, video, ses ve metin dosyalarını internetsiz açar",
  "lang": "tr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16130d",
  "theme_color": "#facc15",
  "icons": [
    {
      "src": "ikon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "ikon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "ikon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".svg",
          ".bmp",
          ".ico",
          ".avif"
        ],
        "video/*": [
          ".mp4",
          ".webm",
          ".mov",
          ".m4v",
          ".ogv",
          ".mkv"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".ogg",
          ".m4a",
          ".aac",
          ".flac",
          ".opus"
        ],
        "text/*": [
          ".txt",
          ".md",
          ".log",
          ".json",
          ".xml",
          ".css",
          ".js",
          ".ini",
          ".srt",
          ".vtt",
          ".yaml",
          ".yml"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/vnd.ms-excel": [
          ".xls",
          ".xlt"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel.sheet.macroEnabled.12": [
          ".xlsm"
        ],
        "application/vnd.ms-excel.sheet.binary.macroEnabled.12": [
          ".xlsb"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/msword": [
          ".doc",
          ".dot"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./paylas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "dosya",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  }
}